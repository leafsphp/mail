{
    "name": "leafs/mail",
    "description": "Simple, straightforward mailing for your Leaf apps",
    "keywords": [
        "mail",
        "smtp",
        "email",
        "phpmailer",
        "leaf",
        "php",
        "framework"
    ],
    "homepage": "https://leafphp.dev/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Darko",
            "email": "mickdd22@gmail.com",
            "homepage": "https://mychi.netlify.app",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Leaf\\": "src"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "phpmailer/phpmailer": "^6.5"
    },
    "require-dev": {
        "pestphp/pest": "*"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
